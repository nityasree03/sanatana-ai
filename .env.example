# Copy this file to .env.local and fill in real values there.
# .env.local is ignored by git — NEVER commit real keys or paste them into chats.

# Google Gemini API key (free tier, no card needed): https://aistudio.google.com → "Get API key".
# Used only on the server. Without it, chat runs in scripture-only mode.
GEMINI_API_KEY=your-key-here

# Model ID (see AI Studio for the models and limits available to your key).
GEMINI_MODEL=gemini-3.8-flash
# Optional: a lighter model to try once if the main one is out of quota.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: chat messages allowed per visitor (IP address) per day, to protect the free quota.
CHAT_DAILY_LIMIT=60

# Tests only — never set in production: AI_PROVIDER=practice uses an offline stand-in AI.
# AI_PROVIDER=practice
