# Copy this file to .env.local and fill in real values there.
# .env.local is ignored by git — NEVER commit real keys.

# Phase 4: Google Gemini API key (free tier, server-side only, no billing)
GEMINI_API_KEY=your-key-here

# Phase 4: which model the provider adapter should use
GEMINI_MODEL=your-model-name-here
