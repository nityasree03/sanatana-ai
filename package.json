{
  "name": "sanatana-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/fetch-model.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/fetch-model.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:py": "cd scripture-pipeline && python3 -m pytest -q",
    "eval:scripture": "vitest run --config vitest.eval.config.ts evaluation/scripture-retrieval",
    "eval:chat": "vitest run --config vitest.eval.config.ts evaluation/chat"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-serif-devanagari": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "next": "16.4.3",
    "onnxruntime-web": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
