# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the placeholder env template (contains NO real secrets)
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# local screenshots / scratch
/screenshots/

# scripture pipeline downloads (re-create with: python -m sanatana_pipeline.fetch)
/scripture-pipeline/raw/

# Downloaded at build time (scripts/fetch-model.mjs)
/models/
